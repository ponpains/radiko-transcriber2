<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="radiko Podcast 文字起こし"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="試作版 0.7"
            android:textColor="#6B7280"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="radiko Podcast URL"
                android:textColor="#6B7280"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:inputType="textUri"
                android:singleLine="true"
                android:text="https://radiko.jp/podcast/episodes/371ac73c-67c7-4cd2-8b87-7b01a381b310?t=870&amp;share=1"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/openRadiko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="radikoアプリでこの回を開く"/>

            <Button
                android:id="@+id/openBrowser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ブラウザでこの回を開く"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文字起こし"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="まず内部音声を試してください。radikoアプリで入力レベルが0のままならブラウザ再生を試し、それでも駄目ならマイク経由を使います。"
                android:textColor="#6B7280"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/internalStartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="① 内部音声で文字起こし開始"/>

            <Button
                android:id="@+id/micStartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="② マイク経由で文字起こし開始"/>

            <Button
                android:id="@+id/stopButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:enabled="false"
                android:text="文字起こし停止"/>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F3F4F6"
                android:padding="12dp"
                android:text="待機中"
                android:textColor="#111827"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/meter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="入力レベル: 0"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="マイク経由では、端末のスピーカーからradikoを流してください。イヤホン使用時はマイクに音が届かないため文字起こしできません。"
                android:textColor="#92400E"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文字起こし結果"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:padding="10dp"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="全文コピー"/>

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="消去"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="内部音声モードはAndroid公式の再生音声キャプチャ機能を使います。再生アプリ側がキャプチャを禁止している場合は取得できません。その場合はブラウザ再生またはマイク経由を使います。"
            android:textColor="#92400E"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
