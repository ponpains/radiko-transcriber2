<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="radiko Podcast 文字起こし"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="試作版 0.8"
            android:textColor="#6B7280"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="radiko Podcast URL"
                android:textColor="#6B7280"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:inputType="textUri"
                android:singleLine="true"
                android:text="https://radiko.jp/podcast/episodes/371ac73c-67c7-4cd2-8b87-7b01a381b310?t=870&amp;share=1"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/openBrowser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="おすすめ：ブラウザでこの回を開く"/>

            <Button
                android:id="@+id/openRadiko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="radikoアプリでこの回を開く"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文字起こし"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="実機ではブラウザ再生＋内部音声で取得できました。①を開始 → Androidの共有を許可 → ブラウザでradikoを再生、の順がおすすめです。認識が途中で終了しても自動で再接続します。"
                android:textColor="#6B7280"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/internalStartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="① ブラウザ内部音声で文字起こし開始"/>

            <Button
                android:id="@+id/micStartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="② マイク経由で文字起こし開始"/>

            <Button
                android:id="@+id/stopButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:enabled="false"
                android:text="文字起こし停止"/>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F3F4F6"
                android:padding="12dp"
                android:text="待機中"
                android:textColor="#111827"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/meter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="入力レベル: 0"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="入力レベルが動いているのに文字が増えなくなった場合は、認識器を自動で再接続します。画面の「自動再接続」の回数で確認できます。"
                android:textColor="#0F766E"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="マイク経由は予備です。端末のスピーカーからradikoを流してください。イヤホン使用時はマイクに音が届きません。"
                android:textColor="#92400E"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文字起こし結果"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:padding="10dp"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="全文コピー"/>

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="消去"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="内部音声モードはAndroid公式の再生音声キャプチャ機能を使います。radikoアプリでは取得できない場合がありますが、ブラウザ再生では取得できることを実機で確認しています。"
            android:textColor="#92400E"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
