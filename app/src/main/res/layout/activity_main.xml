<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ラジオ文字起こし"
            android:textColor="#111827"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="v0.13  •  高速再生バッファ / 診断ログ / 再生位置 / アプリ内Web実験"
            android:textColor="#6B7280"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="新しい回を文字起こし"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/programInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="番組名  例：≠ME 永田詩央里のけれけれ"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/episodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="回の名前  例：2026/09/04 第○回"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="radiko Podcast URL"
                android:inputType="textUri"
                android:singleLine="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="radiko側の再生速度"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <Spinner
                android:id="@+id/playbackSpeedSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.5x / 2.0xは音声取得と認識を分離します。再生を取りこぼさず一時バッファへ保存し、認識後に自動削除します。"
                android:textColor="#6B7280"
                android:textSize="11sp"/>

            <CheckBox
                android:id="@+id/autoStopCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:checked="true"
                android:text="再生終了を判定して自動停止・保存"
                android:textSize="13sp"/>

            <CheckBox
                android:id="@+id/inAppPlaybackCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="実験：開始後は外部ブラウザではなくアプリ内Webで開く"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="文字起こし開始 → 再生画面を開く"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/openBrowserButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="外部ブラウザだけ開く"/>

            <Button
                android:id="@+id/openInAppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="実験：アプリ内Webだけ開く"/>

            <Button
                android:id="@+id/micStartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="内部音声が取れないとき：マイク経由"/>

            <Button
                android:id="@+id/newEpisodeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="＋ 次の回を入力（番組名は引き継ぐ）"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/currentEpisodeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="新しい回"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="#F3F4F6"
                android:padding="12dp"
                android:text="待機中"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/meter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="待機中"
                android:textColor="#0F766E"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/playbackPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#ECFDF5"
                android:padding="10dp"
                android:text="再生位置：—"
                android:textColor="#065F46"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="文字欄を触っても文字起こし本体は止まりません。ホームへ戻った時も自動で再同期します。"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/stopButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:enabled="false"
                android:text="今すぐ停止して保存"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="現在の文字起こし"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="文ごとに改行し、話題転換や長い無音では空行を入れます。左右カーソル移動も使えます。"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="7dp"
                android:background="#FFFFFF"
                android:fadeScrollbars="false"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="always"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/correctionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="停止後に固有名詞などを直すと、番組別辞書として学習できます。"
                android:textColor="#0F766E"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/learnButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="この修正を学習"/>

            <Button
                android:id="@+id/detailButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="この回の詳細・タイムラインを開く"/>

            <Button
                android:id="@+id/copyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="タイムスタンプ付きでコピー"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="最近の回"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/libraryCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0回保存済み"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/openArchiveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:text="アーカイブを開く（全回・検索・絞り込み）"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/programSummaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="番組まとめ"/>

                <Button
                    android:id="@+id/dictionaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="修正辞書"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/libraryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="5dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="データ管理"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="停止・保存時には端末内に3世代の自動バックアップも作ります。"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/diagnosticShareButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="修正用診断パックを共有（直近3回）"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="テスト後はこれをこのチャットへ共有するだけでOKです。中身を確認する必要はありません。音声そのものは含みません。"
                android:textColor="#6B7280"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/backupJsonButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="完全バックアップJSONを書き出す"/>

            <Button
                android:id="@+id/exportCsvButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="一覧・分析用CSVを書き出す"/>

            <Button
                android:id="@+id/restoreBackupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="完全バックアップJSONから復元"/>

            <Button
                android:id="@+id/restoreAutoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="直近の自動バックアップから復元"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingBottom="18dp"
            android:text="安定優先なら外部ブラウザ＋1.0x。アプリ内Webは独立した実験機能なので、合わなければOFFのままで問題ありません。"
            android:textColor="#92400E"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
