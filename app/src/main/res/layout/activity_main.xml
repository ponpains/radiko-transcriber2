<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ラジオ文字起こし"
            android:textColor="#111827"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="v0.9  •  回ごとに自動保存 / 検索 / 分析用書き出し"
            android:textColor="#6B7280"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="新しい回を文字起こし"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="番組名・回の名前・URLを入れて「開始」を押すだけです。共有許可のあとブラウザが自動で開き、その後はバックグラウンドで動きます。"
                android:textColor="#6B7280"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/programInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="番組名  例：≠ME 永田詩央里のけれけれ"
                android:inputType="text"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/episodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="回の名前  例：2026/09/04 第○回"
                android:inputType="text"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="radiko Podcast URL"
                android:inputType="textUri"
                android:singleLine="true"/>

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="文字起こしを開始"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/openBrowserButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="ブラウザだけ開く"/>

            <Button
                android:id="@+id/micStartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="うまく取れないとき：マイク経由で開始"/>

            <Button
                android:id="@+id/newEpisodeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="＋ 別の回を入力する"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/currentEpisodeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="新しい回"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F3F4F6"
                android:padding="12dp"
                android:text="待機中"
                android:textColor="#111827"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/meter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="待機中"
                android:textColor="#0F766E"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="実行中は通知にも状態を表示します。ChatGPTや他のアプリを開いても継続し、通知の「停止して保存」から終了できます。"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/stopButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:enabled="false"
                android:text="停止して保存"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="現在の文字起こし"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="確定した文章は回ごとに自動保存されます。停止後はここで手直しもできます。"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="10dp"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/copyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="この回を情報つきでコピー"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文字起こしライブラリ"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/libraryCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0回保存済み"
                android:textColor="#6B7280"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/librarySearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="番組名・回名・トーク内容を検索"
                android:inputType="text"
                android:singleLine="true"/>

            <LinearLayout
                android:id="@+id/libraryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"/>

            <Button
                android:id="@+id/exportJsonButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="全回を分析用JSONで書き出す"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="JSONには番組名・回名・URL・日時・全文が入ります。あとでまとめて分析するときの元データとして使えます。"
                android:textColor="#6B7280"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingBottom="18dp"
            android:text="推奨：ブラウザ再生＋内部音声。radikoアプリ側から直接取れない音声でも、ブラウザ再生では実機で取得できています。"
            android:textColor="#92400E"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
