<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/archiveBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="← 戻る"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="文字起こしアーカイブ"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/archiveCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0回保存済み"
        android:textColor="#6B7280"
        android:textSize="12sp"/>

    <EditText
        android:id="@+id/archiveSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:hint="回名・本文・タグ・メモを検索"
        android:padding="10dp"
        android:singleLine="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/archiveProgramFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"/>

        <Spinner
            android:id="@+id/archiveDateFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/archiveStatusFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"/>

        <Spinner
            android:id="@+id/archiveSortFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/archiveProgramSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="選択番組のまとめ"/>

        <Button
            android:id="@+id/archiveDictionary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="修正辞書"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingBottom="5dp"
        android:text="一覧は薄い行表示です。検索中は一致した本文の前後を表示します。タップで詳細、長押しで削除。"
        android:textColor="#6B7280"
        android:textSize="11sp"/>

    <ListView
        android:id="@+id/archiveList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#E5E7EB"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true"
        android:scrollbars="vertical"/>
</LinearLayout>
